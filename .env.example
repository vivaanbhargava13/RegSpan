NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Required for ingestion API write routes. Never expose this value with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only n8n ingestion handoff. Never use a NEXT_PUBLIC_ prefix.
N8N_INGEST_WEBHOOK_URL=
N8N_INGEST_WEBHOOK_SECRET=

# Server-only bearer secret used by n8n to call the internal ingestion worker.
INGESTION_WORKER_SECRET=

# Server-only development/debug route toggles. Keep false/blank in production.
ENABLE_MOCK_PROCESSING_ROUTE=
ENABLE_INTERNAL_DEBUG_ROUTES=

# Server-only chunk embedding configuration. Never use a NEXT_PUBLIC_ prefix.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=

# Server-only requirement evidence classifier. Defaults to cheap deterministic heuristics.
# Set REQUIREMENT_CLASSIFIER_PROVIDER=openai only when you want LLM-backed debug grading.
REQUIREMENT_CLASSIFIER_PROVIDER=heuristic
REQUIREMENT_CLASSIFIER_MODEL=
REQUIREMENT_CLASSIFIER_API_KEY=
