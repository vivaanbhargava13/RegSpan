NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Required for ingestion API write routes. Never expose this value with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only n8n ingestion handoff. Never use a NEXT_PUBLIC_ prefix.
N8N_INGEST_WEBHOOK_URL=
N8N_INGEST_WEBHOOK_SECRET=

# Server-only bearer secret used by n8n to call the internal ingestion worker.
INGESTION_WORKER_SECRET=
