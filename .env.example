NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-controlled auth redirects. Use your canonical deployed app origin in production.
APP_BASE_URL=http://localhost:3000
ALLOWED_AUTH_REDIRECT_ORIGINS=http://localhost:3000

# Browser mutation origin allow-list. Comma-separated exact origins only:
# scheme + hostname + optional port, with no path, query, or fragment.
# Local development example: http://localhost:3000
# Production requires explicit HTTPS origins; APP_BASE_URL is also included.
ALLOWED_APP_ORIGINS=http://localhost:3000

# Required for ingestion API write routes. Never expose this value with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only n8n ingestion handoff. Never use a NEXT_PUBLIC_ prefix.
# N8N_INGEST_WEBHOOK_SECRET signs timestamp + "." + raw JSON body with HMAC-SHA256.
# Production requires an HTTPS webhook URL that is not localhost, loopback, or
# host.docker.internal. Generate distinct secrets with: openssl rand -hex 32
N8N_INGEST_WEBHOOK_URL=
N8N_INGEST_WEBHOOK_SECRET=

# Server-only bearer secret used by n8n to call the internal ingestion worker.
# This must be different from N8N_INGEST_WEBHOOK_SECRET.
INGESTION_WORKER_SECRET=

# Durable abuse protection. Production requires REGSPAN_RATE_LIMIT_BACKEND=supabase;
# development and tests may omit it to use the process-local fallback.
REGSPAN_RATE_LIMIT_BACKEND=
REGSPAN_REQUIRE_DURABLE_RATE_LIMITING=
REGSPAN_RATE_LIMIT_DOCUMENT_UPLOADS_PER_HOUR=12
REGSPAN_RATE_LIMIT_DOCUMENT_REPLACES_PER_HOUR=12
REGSPAN_RATE_LIMIT_DOCUMENT_REPROCESSES_PER_HOUR=30
REGSPAN_RATE_LIMIT_DOCUMENT_BULK_ACTIONS_PER_HOUR=20
REGSPAN_RATE_LIMIT_ANALYSIS_PER_HOUR=8
REGSPAN_RATE_LIMIT_PASSWORD_RESETS_PER_15_MINUTES=5
REGSPAN_QUOTA_DOCUMENT_UPLOADS_PER_DAY=100
REGSPAN_QUOTA_UPLOAD_BYTES_PER_DAY=104857600
REGSPAN_QUOTA_PROCESSING_REQUESTS_PER_HOUR=60
REGSPAN_QUOTA_MAX_ACTIVE_PROCESSING_JOBS=2
REGSPAN_QUOTA_MAX_ACTIVE_ANALYSIS_RUNS=1

# Server-only PDF ingestion limits. Values must be positive integers.
MAX_PDF_PAGES=250
MAX_EXTRACTED_TEXT_CHARS=2000000
MAX_PDF_PAGE_TEXT_CHARS=500000
PDF_PROCESSING_TIMEOUT_MS=180000

# Server-only development/debug route toggles. Keep false/blank in production.
ENABLE_MOCK_PROCESSING_ROUTE=
ENABLE_INTERNAL_DEBUG_ROUTES=

# Server-only external AI policy gates. Required before sending document text
# to external AI providers for embeddings or LLM-backed debug classification.
ENABLE_EXTERNAL_AI_PROCESSING=
ENABLE_EXTERNAL_AI_CLASSIFIER=

# Server-only chunk embedding configuration. Never use a NEXT_PUBLIC_ prefix.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=

# Optional server-only OpenAI fallback key. Dangerous if exposed to the browser.
OPENAI_API_KEY=

# Optional server-only chunk synopsis generation. Dangerous if exposed to the browser.
CHUNK_SYNOPSIS_MODEL=
CHUNK_SYNOPSIS_API_KEY=

# Server-only requirement evidence classifier. Defaults to cheap deterministic heuristics.
# Set REQUIREMENT_CLASSIFIER_PROVIDER=openai only when you want LLM-backed debug grading.
REQUIREMENT_CLASSIFIER_PROVIDER=heuristic
REQUIREMENT_CLASSIFIER_MODEL=
REQUIREMENT_CLASSIFIER_API_KEY=
