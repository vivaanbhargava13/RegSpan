# Sanitized production example. Copy to an untracked secret-manager-backed file.
# Never commit the populated file. Values below are placeholders only.

N8N_BIND_PORT=5678
N8N_HOST=editor.example.invalid
N8N_EDITOR_BASE_URL=https://editor.example.invalid/
WEBHOOK_URL=https://hooks.example.invalid/
N8N_PROXY_HOPS=1
GENERIC_TIMEZONE=America/New_York
TZ=America/New_York

POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=replace-with-random-postgres-password

# Generate with: openssl rand -hex 32
# Back up this value separately; losing it makes encrypted credentials unreadable.
N8N_ENCRYPTION_KEY=replace-with-random-persistent-encryption-key

# Retain no execution payloads. These values only bound execution-row metadata.
EXECUTIONS_DATA_MAX_AGE=168
EXECUTIONS_DATA_PRUNE_MAX_COUNT=1000
