# Copy this file to .env for local n8n. Never commit .env.
# Generate each secret with: openssl rand -hex 32

N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
TZ=America/New_York

# Server-only HMAC signing secret.
# Must match RegSpan .env.local N8N_INGEST_WEBHOOK_SECRET.
N8N_INGEST_WEBHOOK_SECRET=replace-with-64-hex-hmac-secret

# Server-only worker bearer secret.
# Must match RegSpan .env.local INGESTION_WORKER_SECRET.
# Must be different from N8N_INGEST_WEBHOOK_SECRET.
INGESTION_WORKER_SECRET=replace-with-different-64-hex-worker-secret

# Local n8n credential encryption key. Keep this separate from the webhook and
# worker secrets.
N8N_ENCRYPTION_KEY=replace-with-different-64-hex-n8n-encryption-key
