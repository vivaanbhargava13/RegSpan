# Copy to .env.staging, replace every placeholder, and never commit that file.
# This sanitized file is for `docker compose config`; it intentionally fails the
# production startup preflight until real staging values are supplied securely.

APP_BASE_URL=https://app.staging.invalid
ALLOWED_AUTH_REDIRECT_ORIGINS=https://app.staging.invalid
ALLOWED_APP_ORIGINS=https://app.staging.invalid

NEXT_PUBLIC_SUPABASE_URL=https://project.staging.invalid
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-staging-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-staging-service-role-key

N8N_INGEST_WEBHOOK_URL=https://hooks.staging.invalid/webhook/replace-path
N8N_INGEST_WEBHOOK_SECRET=replace-with-staging-hmac-secret
INGESTION_WORKER_SECRET=replace-with-different-staging-worker-secret

REGSPAN_RATE_LIMIT_BACKEND=supabase
REGSPAN_REQUIRE_DURABLE_RATE_LIMITING=true
REGSPAN_QUOTA_MAX_ACTIVE_PROCESSING_JOBS=1
REGSPAN_QUOTA_MAX_ACTIVE_ANALYSIS_RUNS=1

MAX_PDF_PAGES=250
MAX_EXTRACTED_TEXT_CHARS=2000000
MAX_PDF_PAGE_TEXT_CHARS=500000
PDF_PROCESSING_TIMEOUT_MS=180000
# Keep at least 60000 ms above PDF_PROCESSING_TIMEOUT_MS and below the
# Compose stop_grace_period.
REGSPAN_SHUTDOWN_GRACE_MS=330000

ENABLE_EXTERNAL_AI_PROCESSING=false
ENABLE_EXTERNAL_AI_CLASSIFIER=false
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
OPENAI_API_KEY=
CHUNK_SYNOPSIS_MODEL=
CHUNK_SYNOPSIS_API_KEY=
REQUIREMENT_CLASSIFIER_PROVIDER=heuristic
REQUIREMENT_CLASSIFIER_MODEL=
REQUIREMENT_CLASSIFIER_API_KEY=
